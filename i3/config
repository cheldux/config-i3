
include ~/.config/i3/config.d/keybind.conf
include ~/.config/i3/config.d/style.conf
include ~/.config/i3/config.d/start.conf

# set $mod to Super key
set $mod Mod4

set $refresh_i3status killall -SIGUSR1 i3status

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

set $d_blue "#458588"
set $l_blue "#83a598"
set $d_red "#cc241d"
set $l_red "#fb4934"
set $fg "#ebdbb2"
set $bg "#282828"
set $bg0_h "#1d2021"


